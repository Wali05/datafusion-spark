## Original Query: SELECT elt(1, 'scala', 'java');
## PySpark 3.5.5 Result: {'elt(1, scala, java)': 'scala', 'typeof(elt(1, scala, java))': 'string', 'typeof(1)': 'int', 'typeof(scala)': 'string', 'typeof(java)': 'string'}
query T
SELECT elt(1::int, 'scala'::string, 'java'::string);
----
scala

## Original Query: SELECT elt(2, 'a', 1);
## PySpark 3.5.5 Result: {'elt(2, a, 1)': '1', 'typeof(elt(2, a, 1))': 'string', 'typeof(2)': 'int', 'typeof(a)': 'string', 'typeof(1)': 'int'}
query T
SELECT elt(2::int, 'a'::string, 1::int);
----
1

query T
SELECT elt(11::int, 10, 20)
----
NULL

query T
SELECT elt(1::int, 10, 20)
----
10

query T
SELECT elt(1::int, null, 20)
----
NULL

query T
SELECT elt(1::int, 10, null)
----
10

query T
SELECT elt(1, 10, null)
----
10

########################################
# ANSI mode = false (default): invalid indices return NULL
########################################

# Index 0 -> NULL (Spark returns NULL when ANSI is off)
query T
SELECT elt(0::int, 'a', 'b');
----
NULL

# Negative index -> NULL
query T
SELECT elt(-1::int, 'a', 'b');
----
NULL

# Index far beyond the input list -> NULL
query T
SELECT elt(100::int, 'a', 'b', 'c');
----
NULL

# NULL index -> NULL regardless of mode
query T
SELECT elt(NULL::int, 'a', 'b');
----
NULL

# NULL value at the selected index -> NULL
query T
SELECT elt(2::int, 'a', NULL);
----
NULL

# Three-argument list, pick middle element
query T
SELECT elt(2::int, 'scala', 'java', 'python');
----
java

# Three-argument list, pick last element
query T
SELECT elt(3::int, 'scala', 'java', 'python');
----
python

# Mixed types get cast to string (Spark returns string)
query T
SELECT elt(2::int, 1, 2, 3);
----
2

# Vectorized: mix of valid, out-of-range, and NULL indices in ANSI-off mode
statement ok
CREATE TABLE elt_rows(idx INT, a STRING, b STRING, c STRING) AS VALUES
    (1, 'a1', 'b1', 'c1'),
    (2, 'a2', 'b2', 'c2'),
    (3, 'a3', 'b3', 'c3'),
    (0, 'a4', 'b4', 'c4'),
    (-1, 'a5', 'b5', 'c5'),
    (4, 'a6', 'b6', 'c6'),
    (NULL, 'a7', 'b7', 'c7');

query T
SELECT elt(idx, a, b, c) FROM elt_rows ORDER BY a;
----
a1
b2
c3
NULL
NULL
NULL
NULL

statement ok
DROP TABLE elt_rows;

########################################
# Binary inputs: Spark returns BINARY when every value argument is binary
# (EltTypeCoercion in TypeCoercionHelper.scala). The eltOutputAsString flag
# (default false) is not implemented yet, tracked by
# https://github.com/apache/datafusion-spark/issues/92
########################################

# All value arguments binary -> result is Binary (hex-rendered)
query ?T
SELECT elt(1::int, arrow_cast('scala', 'Binary'), arrow_cast('java', 'Binary')), arrow_typeof(elt(1::int, arrow_cast('scala', 'Binary'), arrow_cast('java', 'Binary')));
----
7363616c61 Binary

# All value arguments binary, binary literals, pick the second
query ?
SELECT elt(2::int, x'636166', x'c3a9');
----
c3a9

# Widest binary type wins: LargeBinary
query ?T
SELECT elt(1::int, arrow_cast('x', 'LargeBinary'), arrow_cast('y', 'LargeBinary')), arrow_typeof(elt(1::int, arrow_cast('x', 'LargeBinary'), arrow_cast('y', 'LargeBinary')));
----
78 LargeBinary

# Widest binary type wins: BinaryView
query ?T
SELECT elt(1::int, arrow_cast('x', 'BinaryView'), arrow_cast('y', 'BinaryView')), arrow_typeof(elt(1::int, arrow_cast('x', 'BinaryView'), arrow_cast('y', 'BinaryView')));
----
78 BinaryView

# Mixed binary + string -> result falls back to string (Utf8)
query TT
SELECT elt(1::int, arrow_cast('hello', 'Binary'), 'world'), arrow_typeof(elt(1::int, arrow_cast('hello', 'Binary'), 'world'));
----
hello Utf8

# Binary with a NULL-typed argument -> string, because NullType is not binary
# (Spark: children.tail.forall(_ == BinaryType) is false, so the output is a string)
query TT
SELECT elt(1::int, arrow_cast('hello', 'Binary'), NULL), arrow_typeof(elt(1::int, arrow_cast('hello', 'Binary'), NULL));
----
hello Utf8

# Picking a NULL binary value returns NULL but keeps the Binary type
query ?T
SELECT elt(2::int, arrow_cast('a', 'Binary'), arrow_cast(NULL, 'Binary')), arrow_typeof(elt(2::int, arrow_cast('a', 'Binary'), arrow_cast(NULL, 'Binary')));
----
NULL Binary

# Column-based binary inputs: valid, picked, and out-of-range (index 3 -> NULL)
query ?T
SELECT elt(idx, a, b), arrow_typeof(elt(idx, a, b))
FROM (VALUES
    (1, arrow_cast('a1', 'Binary'), arrow_cast('b1', 'Binary')),
    (2, arrow_cast('a2', 'Binary'), arrow_cast('b2', 'Binary')),
    (3, arrow_cast('a3', 'Binary'), arrow_cast('b3', 'Binary'))
) AS t(idx, a, b)
ORDER BY idx;
----
6131 Binary
6232 Binary
NULL Binary

########################################
# ANSI mode = true: invalid indices raise ArrayIndexOutOfBoundsException
########################################

statement ok
set datafusion.execution.enable_ansi_mode = true;

# Valid indices still work
query T
SELECT elt(1::int, 'scala', 'java');
----
scala

query T
SELECT elt(2::int, 'scala', 'java');
----
java

# NULL index still returns NULL (matches Spark: no error when index itself is NULL)
query T
SELECT elt(NULL::int, 'a', 'b');
----
NULL

# NULL value at valid index still returns NULL (only invalid indices error)
query T
SELECT elt(1::int, NULL, 'b');
----
NULL

# Out-of-range positive index errors
statement error
SELECT elt(3::int, 'scala', 'java');
----
DataFusion error: Execution error: The index 3 is out of bounds. The array has 2 elements.


# Zero index errors
statement error
SELECT elt(0::int, 'scala', 'java');
----
DataFusion error: Execution error: The index 0 is out of bounds. The array has 2 elements.


# Negative index errors
statement error
SELECT elt(-1::int, 'scala', 'java');
----
DataFusion error: Execution error: The index -1 is out of bounds. The array has 2 elements.


# Large positive index errors
statement error
SELECT elt(100::int, 'a', 'b', 'c');
----
DataFusion error: Execution error: The index 100 is out of bounds. The array has 3 elements.


# Out-of-range index with all-binary values still errors in ANSI mode
statement error
SELECT elt(3::int, arrow_cast('a', 'Binary'), arrow_cast('b', 'Binary'));
----
DataFusion error: Execution error: The index 3 is out of bounds. The array has 2 elements.


# Vectorized: a batch that contains any invalid index errors in ANSI mode
statement ok
CREATE TABLE elt_ansi(idx INT, a STRING, b STRING) AS VALUES
    (1, 'a1', 'b1'),
    (2, 'a2', 'b2'),
    (3, 'a3', 'b3');

statement error
SELECT elt(idx, a, b) FROM elt_ansi;
----
DataFusion error: Execution error: The index 3 is out of bounds. The array has 2 elements.


statement ok
DROP TABLE elt_ansi;

# Reset ANSI mode
statement ok
set datafusion.execution.enable_ansi_mode = false;
